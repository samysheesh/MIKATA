# Copier ce fichier en .env (jamais commité) et renseigner les clés.

# Obligatoire. Clé du LLM cloud : toute API compatible OpenAI (llm.base_url et llm.model dans
# config.yaml). Par défaut : OpenCode Zen (https://opencode.ai/zen).
LLM_API_KEY=

# Recommandée. Recherche web et météo. Tavily (gratuit, 1 000 recherches par mois, sans
# carte) : https://app.tavily.com -> API Keys -> « tvly-... ».
# Brave Search (carte bancaire obligatoire) : mettre aussi web.search_provider: brave.
SEARCH_API_KEY=

# Facultative. Voix ElevenLabs (payante) : https://elevenlabs.io -> Developers -> API Keys.
# Droits : Text to Speech, User (lecture du solde), Voices (lecture et écriture pour
# scripts/eleven_voices.py). Sans clé, MIKATA parle avec Kokoro.
ELEVENLABS_API_KEY=

# Facultative. Jev (via OpenRouter) reconnaît en ~0,4 s une compétence déjà apprise
# (skills.jev). Sans clé, un petit appel au LLM principal s'en charge.
OPENROUTER_API_KEY=
