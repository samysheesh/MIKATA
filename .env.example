# Copier ce fichier en .env (jamais commité) et renseigner les clés.
# Clé API du LLM cloud (OpenCode Zen, compatible OpenAI) — utilisée à partir de la phase 3.
LLM_API_KEY=
# Clé API de recherche web — utilisée à partir de la phase 4. Tavily recommandé (gratuit,
# 1 000 recherches par mois, sans carte) : https://app.tavily.com -> API Keys -> « tvly-... ».
# Brave Search (carte bancaire obligatoire) : mettre aussi web.search_provider: brave.
SEARCH_API_KEY=
