# Copy this file to .env (never committed) and fill in the keys.

# Required. Cloud LLM key: any OpenAI-compatible API (llm.base_url and llm.model in
# config.yaml).
LLM_API_KEY=

# Recommended. Web search. Tavily (free, 1,000 searches per month, no card needed):
# https://app.tavily.com -> API Keys -> "tvly-...".
# Brave Search (credit card required): also set web.search_provider: brave.
SEARCH_API_KEY=

# Optional. ElevenLabs voice (paid): https://elevenlabs.io -> Developers -> API Keys.
# Permissions: Text to Speech, User (read the balance), Voices (read and write, for
# scripts/eleven_voices.py). Without a key, MIKATA speaks with Kokoro.
ELEVENLABS_API_KEY=

# Optional. Jev (through OpenRouter) recognizes an already learned skill in ~0.4 s
# (skills.jev). Without a key, a small call to the main LLM does it instead.
OPENROUTER_API_KEY=
